# syntax=docker/dockerfile:1
# Многостадийная сборка: зависимости ставятся в venv на стадии builder,
# финальный образ — slim без тулчейна, процесс от non-root пользователя.

FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Сначала только зависимости: слой переиспользуется, пока не менялся
# pyproject.toml. Правка кода больше не тянет за собой переустановку
# всего дерева пакетов.
COPY backend/pyproject.toml ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -c "import tomllib, pathlib; \
deps = tomllib.loads(pathlib.Path('pyproject.toml').read_text())['project']['dependencies']; \
pathlib.Path('/tmp/requirements.txt').write_text('\n'.join(deps))" \
    && /opt/venv/bin/pip install -r /tmp/requirements.txt

# Теперь сам код: этот слой пересобирается быстро
COPY backend/app ./app
RUN /opt/venv/bin/pip install --no-deps .


FROM python:3.12-slim

RUN useradd --system --uid 10001 --no-create-home appuser

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
# Миграции нужны в образе: alembic upgrade head выполняется из контейнера
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER 10001
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
