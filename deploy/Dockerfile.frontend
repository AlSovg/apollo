# syntax=docker/dockerfile:1
# Стадия сборки: Nuxt генерирует статику. Финальный образ — только nginx
# без root-привилегий; Node-процесса в продуктивном контуре нет (AGENTS.md §2).

FROM node:22-alpine AS builder

WORKDIR /build
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./

# Учётки кнопок быстрого входа на демо-стенде («логин:пароль»). Пусто по
# умолчанию: без них кнопок нет и в статику не попадает ни одного пароля.
ARG NUXT_PUBLIC_DEMO_USER=""
ARG NUXT_PUBLIC_DEMO_ADMIN=""
ENV NUXT_PUBLIC_DEMO_USER=$NUXT_PUBLIC_DEMO_USER \
    NUXT_PUBLIC_DEMO_ADMIN=$NUXT_PUBLIC_DEMO_ADMIN

RUN npm run generate


FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/.output/public /usr/share/nginx/html

EXPOSE 8080
