# Скопировать в .env и заполнить. Секреты в репозиторий не коммитятся.

# PostgreSQL (контейнер db)
POSTGRES_USER=apollo
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=apollo

# Бэкенд. Пароль должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://apollo:__CHANGE_ME__@db:5432/apollo

APP_ENV=dev
LOG_LEVEL=INFO

# На сколько месяцев вперёд создавать партиции raw_events / incident_events
PARTITIONS_MONTHS_AHEAD=1

# Локальное время сервера Zabbix: в payload таймзоны нет.
# Ошибка здесь смещает все инциденты на N часов.
ZABBIX_TZ=Europe/Moscow

# Нормализация
NORMALIZER_BATCH_SIZE=100
NORMALIZER_POLL_INTERVAL_S=1.0
SUPPRESS_WINDOW_MINUTES=15

# Аутентификация
AUTH_PROVIDER=local
JWT_SECRET=__CHANGE_ME__МИНИМУМ_32_СИМВОЛА__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
# false только для локальной отладки по http
COOKIE_SECURE=true

# Каталог (при AUTH_PROVIDER=ldap). LDAPS обязателен в бою
LDAP_HOST=
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_ID_ATTRIBUTE=objectGUID
LDAP_GROUP_OBJECT_CLASS=group
LDAP_SYNC_INTERVAL_MINUTES=60

# Доставка
ROUTER_BATCH_SIZE=100
DELIVERY_BATCH_SIZE=50
DELIVERY_RETRY_DELAYS_MINUTES=1,5,30

# SMTP (дублирующий канал)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=alerts@example.local
SMTP_USE_TLS=true

# TrueConf Server (обязательный канал по условиям кейса)
TRUECONF_BASE_URL=
TRUECONF_CLIENT_ID=
TRUECONF_CLIENT_SECRET=
TRUECONF_VERIFY_TLS=true

# Локальная модель (ВМ №4, OpenAI-совместимый endpoint). Внешние API запрещены.
# Без /v1 в конце — путь дописывает клиент. Ключ выдаёт администратор ВМ.
LLM_BASE_URL=http://10.0.0.4:8000
LLM_MODEL=qwen3-14b
LLM_API_KEY=
# Qwen3-14B-AWQ на Tesla T4 отвечает 7-15 секунд
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=2
# Пачка идёт одной транзакцией: крупный батч держит блокировки минутами
LLM_BATCH_SIZE=5
# Отключает блок рассуждений <think> у гибридных reasoning-моделей
LLM_DISABLE_THINKING=true
LLM_PROMPT_VERSION=v1
# Маскирование выключено: модель работает внутри контура
LLM_MASK_PII=false

# Квитирование заложено структурно, механики в прототипе нет
FEATURE_ACK=false
