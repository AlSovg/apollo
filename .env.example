# Скопировать в .env и заполнить. Секреты в репозиторий не коммитятся.
#
# Значения по умолчанию рассчитаны на dev-оверлей (docker-compose.dev.yml):
# внешние системы, доступа к которым у проверяющего нет, указывают на моки
# внутри Compose. Заменить надо только помеченное __CHANGE_ME__ — после этого
# `up` + миграции + app.seed + app.demo_seed дают рабочий стенд без единого
# внешнего адреса. Боевые значения выписаны рядом в комментариях.

# PostgreSQL (контейнер db)
POSTGRES_USER=apollo
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=apollo

# Бэкенд. Пароль должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://apollo:__CHANGE_ME__@db:5432/apollo

# Только при БД на отдельном узле (docs/topology.md, ADR-0006).
# Узел БД: адрес узла в оверлейной сети — порт публикуется только на него
# DB_BIND_ADDR=100.x.y.z
# DB_BIND_PORT=5432
# Узел приложения: сколько ждать соединения с БД, секунды
# DB_CONNECT_TIMEOUT_S=5

APP_ENV=dev
LOG_LEVEL=INFO

# На сколько месяцев вперёд создавать партиции raw_events / incident_events
PARTITIONS_MONTHS_AHEAD=1

# Локальное время сервера Zabbix: в payload таймзоны нет.
# Ошибка здесь смещает все инциденты на N часов.
ZABBIX_TZ=Europe/Moscow

# Нормализация
NORMALIZER_BATCH_SIZE=100
NORMALIZER_POLL_INTERVAL_S=1.0
SUPPRESS_WINDOW_MINUTES=15

# Аутентификация
# local — для первого запуска и разработки без каталога. Боевой AD заказчика
# сейчас недоступен для стенда (удалённая ВМ с Samba AD DC отключена) — ветка
# ldap проверяется только против локального мока (см. ниже).
AUTH_PROVIDER=local
JWT_SECRET=__CHANGE_ME__МИНИМУМ_32_СИМВОЛА__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
# false только для локальной отладки по http
COOKIE_SECURE=true

# Каталог (при AUTH_PROVIDER=ldap). Значения ниже — под реальный AD
# (сервисные атрибуты sAMAccountName/objectGUID/group, LDAPS с проверкой
# сертификата) и остаются целевыми для продакшена заказчика.
#
# Для локальной проверки ветки — сервис `ldap` из dev-оверлея
# (osixia/openldap, deploy/ldap/01-structure.ldif):
#   LDAP_HOST=ldap
#   LDAP_PORT=389
#   LDAP_USE_SSL=false
#   LDAP_BASE_DN=dc=apollo,dc=test
#   LDAP_BIND_DN=cn=admin,dc=apollo,dc=test
#   LDAP_BIND_PASSWORD=ldap-admin-pass
#   LDAP_USERNAME_ATTRIBUTE=uid
#   LDAP_ID_ATTRIBUTE=entryUUID
#   LDAP_GROUP_OBJECT_CLASS=groupOfNames
#   LDAP_CA_CERTS_FILE=
LDAP_HOST=
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_ID_ATTRIBUTE=objectGUID
LDAP_GROUP_OBJECT_CLASS=group
LDAP_SYNC_INTERVAL_MINUTES=60
# CA каталога: обязателен для боевого LDAPS (CERT_REQUIRED). Пусто — для
# локального мока, у него нет TLS
LDAP_CA_CERTS_FILE=
# Атрибуты с адресами доставки. Значения не сохраняются в БД (требование ПДн):
# запрашиваются из каталога в момент отправки
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_TRUECONF_ATTRIBUTE=ipPhone

# Доставка
ROUTER_BATCH_SIZE=100
DELIVERY_BATCH_SIZE=50
DELIVERY_RETRY_DELAYS_MINUTES=1,5,30

# SMTP (канал email)
#
# На стенде — mailpit из dev-оверлея: ловит письма, веб-интерфейс на
# http://localhost:8025. Он заменяет и почтовый релей заказчика, и канал
# TrueConf (см. ниже). С пустым SMTP_HOST уведомления канала email штатно
# уходят в failed, остальной конвейер не страдает.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=alerts@apollo.test
SMTP_USE_TLS=false

# TrueConf Server — канал отключён: боевая ВМ недоступна, мок в dev-оверлее
# закомментирован. Пусто — уведомления этого канала уходят в failed, как с
# пустым SMTP_HOST. На стенде его роль играет email через mailpit.
# Chatbot Connector TrueConf 5.5: бот — обычная учётка сервера, адрес
# получателя — TrueConf ID, НЕ email.
TRUECONF_BASE_URL=
TRUECONF_USERNAME=
TRUECONF_PASSWORD=
TRUECONF_VERIFY_TLS=false

# Языковая модель для сводок инцидентов. Внешние API запрещены.
#   template — детерминированный шаблон: поля и метрики события подставляются
#              в готовые формулировки, модель и сеть не нужны (по умолчанию);
#   openai   — OpenAI-совместимый endpoint (vLLM с Qwen3 на отдельной ВМ или
#              llm-mock из dev-оверлея). Тогда нужны LLM_BASE_URL (без /v1)
#              и LLM_MODEL, ключ выдаёт администратор ВМ.
LLM_PROVIDER=template
# Ниже — только для LLM_PROVIDER=openai
LLM_BASE_URL=http://llm-mock:8080
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=
# Qwen3-14B-AWQ на Tesla T4 отвечает 7-15 секунд
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=2
# Пачка идёт одной транзакцией: крупный батч держит блокировки минутами
LLM_BATCH_SIZE=5
# Отключает блок рассуждений <think> у гибридных reasoning-моделей
LLM_DISABLE_THINKING=true
LLM_PROMPT_VERSION=v1
# Маскирование выключено: модель работает внутри контура
LLM_MASK_PII=false

# Квитирование заложено структурно, механики в прототипе нет
FEATURE_ACK=false

# Токены приёма вебхуков: одно значение на источник, объявленное здесь.
# Применяются в реестр командой
#   docker compose exec backend python -m app.cli sync-tokens
# и тем же значением настраивается отправитель — боевой Zabbix, SolarWinds
# или эмулятор стенда. Копировать секрет между двумя местами не требуется.
# Ротация в бою — issue-token: он генерирует новый и печатает один раз.
INGEST_TOKEN_ZABBIX=__CHANGE_ME__
INGEST_TOKEN_SOLARWINDS=__CHANGE_ME__
# HMAC-подпись тела, hex-строка. Пусто — подпись не требуется
INGEST_HMAC_ZABBIX=
INGEST_HMAC_SOLARWINDS=

# Эмулятор источников (dev-оверлей, профиль demo). Подменяет генераторы событий
# на ВМ №1 и №2, пока к ним нет доступа; токены берёт из INGEST_TOKEN_* выше
# Пауза между событиями потока: 25 с — примерно 2-3 события в минуту, инбокс
# за час показа не заплывает. Для нагрузочного прогона есть tools/load_generator.py
SIM_INTERVAL_S=25
# Доля повторов уже открытой проблемы и доля закрытий среди них
SIM_DUP_RATIO=0.45
SIM_RESOLVE_RATIO=0.3
# false — сервис поднимается на паузе и ждёт сценариев с /scenario/{name}
SIM_AUTOSTART=true
# Таймзона в payload — та же, что настроена у источника в реестре
SIM_TZ=Europe/Moscow
